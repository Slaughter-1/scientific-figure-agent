{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/figure-agent/r2_holdout_input.schema.json",
  "title": "R2 independent holdout input",
  "description": "Input contract for independent R2 material. This schema records provenance and independence; it does not generate candidates or scores.",
  "oneOf": [
    {
      "$ref": "#/$defs/pending"
    },
    {
      "$ref": "#/$defs/complete"
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "round_id": {
          "const": "R2"
        },
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": ["round_id", "baseline_commit"]
    },
    "pending": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["round_id", "baseline_commit", "status", "cases"],
          "properties": {
            "round_id": {
              "const": "R2"
            },
            "baseline_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "status": {
              "const": "pending_independent_material"
            },
            "cases": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    "complete": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["round_id", "baseline_commit", "status", "cases"],
          "properties": {
            "round_id": {
              "const": "R2"
            },
            "baseline_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "status": {
              "const": "ready"
            },
            "cases": {
              "type": "array",
              "minItems": 20,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/case"
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "category",
        "source_text",
        "provenance",
        "owner",
        "independence_attestation"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^r2_(sequence|branch|feedback|parallel_merge|containment|mixed)_[0-9]{2}$"
        },
        "category": {
          "enum": [
            "sequence",
            "branch",
            "feedback",
            "parallel_merge",
            "containment",
            "mixed"
          ]
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_kind", "source_reference", "selection_rule"],
          "properties": {
            "source_kind": {
              "type": "string",
              "minLength": 1
            },
            "source_reference": {
              "type": "string",
              "minLength": 1
            },
            "selection_rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name_or_id", "role", "not_involved_in_debugging"],
          "properties": {
            "name_or_id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "not_involved_in_debugging": {
              "const": true
            }
          }
        },
        "independence_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attested_by", "attested_at", "statement"],
          "properties": {
            "attested_by": {
              "type": "string",
              "minLength": 1
            },
            "attested_at": {
              "type": "string",
              "format": "date-time"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
